# Copiez ce fichier en ".env.local" et remplissez avec vos clés Supabase
# (Dashboard Supabase > Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Nécessaire UNIQUEMENT pour la création de comptes caissiers par l'administrateur.
# ⚠️ Cette clé donne un accès total à la base de données : ne JAMAIS la préfixer par
# NEXT_PUBLIC_ (elle ne doit jamais être envoyée au navigateur), et la marquer comme
# "Sensitive" dans Vercel. Trouvable dans Supabase > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role-secrete
